# =============================================================
# Supplier 360 — Backend Environment Configuration
# =============================================================

# --- Database (Neon Cloud PostgreSQL) ---
# Copy the connection string from your Neon project dashboard:
# Neon Console -> Project -> Dashboard -> "Connection Details" (select PostgreSQL)
# Example:
# DATABASE_URL=postgresql://neondb_owner:npg_sample123@ep-cool-sample-a2.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_SYNC=postgresql://neondb_owner:npg_sample123@ep-cool-sample-a2.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-your-instance.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_SYNC=postgresql://your_user:your_password@ep-your-instance.region.aws.neon.tech/neondb?sslmode=require

# --- Qdrant Vector DB ---
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=contract_chunks

# --- LLM Provider (Groq) ---
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL_NAME=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1

# --- Embedding & Reranker ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=false

# --- File Storage ---
UPLOAD_DIR=data/contracts
MAX_UPLOAD_SIZE_MB=20

# --- CORS & Application ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
APP_NAME=Supplier 360
APP_VERSION=1.0.0
DEBUG=false
