# =============================================================
# Supplier 360 — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://supplier360:supplier360_dev@localhost:5432/supplier360
DATABASE_URL_SYNC=postgresql://supplier360:supplier360_dev@localhost:5432/supplier360

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=contract_chunks

# --- LLM Provider (Groq) ---
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL_NAME=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1

# --- Embedding Model ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Reranker (optional) ---
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=false

# --- File Storage ---
UPLOAD_DIR=data/contracts
MAX_UPLOAD_SIZE_MB=20

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- App ---
APP_NAME=Supplier 360
APP_VERSION=1.0.0
DEBUG=true=
